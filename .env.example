# Core runtime
NODE_ENV=development
PORT=3000
APP_NAME=gtm-os-portfolio
LOG_LEVEL=info
API_BASE_URL=http://localhost:3000
WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-string
APP_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=replace-with-a-32-character-key

# HubSpot
HUBSPOT_ACCESS_TOKEN=replace-me

# Slack
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_DEFAULT_CHANNEL_ID=C0000000000

# Default AI provider: free local inference with Ollama
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Background orchestration (keep server-side and secret)
CRON_SECRET=replace-with-a-long-random-string

# Authorized ATS/job sources. Board/site identifiers are comma-separated.
# Greenhouse public GET endpoints usually do not require a key.
GREENHOUSE_API_KEY=replace-me
GREENHOUSE_BOARD_TOKENS=company-one,company-two
LEVER_API_KEY=replace-me
LEVER_SITE_NAMES=company-one,company-two
ASHBY_API_KEY=replace-me
ASHBY_JOB_BOARDS=company-one,company-two
ADZUNA_APP_ID=replace-me
ADZUNA_APP_KEY=replace-me
ADZUNA_COUNTRY=in
ADZUNA_QUERY=marketing OR growth OR GTM OR social media

# Optional documentation storage
NOTION_API_KEY=secret_replace_me
NOTION_DATABASE_ID=replace-me

# Optional premium AI providers
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-opus-4-1

# Optional premium data-source plugins
APOLLO_API_KEY=replace-me
CLAY_API_KEY=replace-me
GMAIL_CLIENT_ID=replace-me
GMAIL_CLIENT_SECRET=replace-me
GOOGLE_CALENDAR_CLIENT_ID=replace-me
GOOGLE_CALENDAR_CLIENT_SECRET=replace-me

# Optional observability integrations
SENTRY_DSN=https://example.ingest.sentry.io/000000
BETTER_STACK_SOURCE_TOKEN=replace-me
